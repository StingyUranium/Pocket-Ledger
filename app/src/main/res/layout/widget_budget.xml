<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="@dimen/widget_space" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/widget_space" android:layout_marginBottom="@dimen/widget_small_space" android:text="@string/widget_month_preview"
        android:textColor="@color/widget_secondary" android:textSize="@dimen/widget_label_size" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    <TextView android:id="@+id/widget_budget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/widget_space"
        android:text="@string/widget_remaining_label" android:textColor="@color/widget_secondary" android:textSize="@dimen/widget_label_size"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_remaining" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:minHeight="@dimen/widget_touch_target" android:paddingHorizontal="@dimen/widget_space" android:gravity="center_vertical"
        android:text="@string/widget_amount_preview" android:textColor="@color/widget_amount_text" android:textSize="@dimen/widget_amount_size"
        android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="@dimen/widget_label_size" android:autoSizeMaxTextSize="@dimen/widget_amount_size" android:autoSizeStepGranularity="1sp" />
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginHorizontal="@dimen/widget_space"
        android:layout_marginVertical="@dimen/widget_small_space" android:max="1000" android:progress="0" android:progressDrawable="@drawable/widget_progress"
        android:progressTint="@color/widget_accent" android:progressBackgroundTint="@color/widget_panel" android:importantForAccessibility="no" />
    <ProgressBar android:id="@+id/widget_progress_over" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginHorizontal="@dimen/widget_space"
        android:layout_marginVertical="@dimen/widget_small_space" android:max="1000" android:progress="0" android:progressDrawable="@drawable/widget_progress"
        android:progressTint="@color/widget_expense" android:progressBackgroundTint="@color/widget_panel" android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:id="@+id/widget_budget_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/widget_space" android:layout_marginTop="@dimen/widget_small_space" android:text="@string/widget_budget_preview"
        android:textColor="@color/widget_secondary" android:textSize="@dimen/widget_label_size" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
</LinearLayout>
