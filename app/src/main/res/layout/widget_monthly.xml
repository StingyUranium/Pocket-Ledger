<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="@dimen/widget_space" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/widget_space" android:layout_marginBottom="@dimen/widget_space" android:text="@string/widget_month_preview"
        android:textColor="@color/widget_secondary" android:textSize="@dimen/widget_label_size" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/widget_touch_target" android:orientation="horizontal"
        android:background="@drawable/widget_panel" android:baselineAligned="false">
        <TextView android:id="@+id/widget_income_tab" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="@string/widget_income_label" android:textSize="@dimen/widget_tab_size"
            android:fontFamily="sans-serif-medium" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="@dimen/widget_tab_size" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_expense_tab" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="@string/widget_expenses_label" android:textSize="@dimen/widget_tab_size"
            android:fontFamily="sans-serif-medium" android:textColor="@color/widget_accent" android:background="@drawable/widget_selected"
            android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="@dimen/widget_tab_size" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_total" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:minHeight="@dimen/widget_touch_target" android:gravity="center_vertical|start" android:paddingHorizontal="@dimen/widget_space"
        android:text="@string/widget_amount_preview" android:textColor="@color/widget_text" android:textSize="@dimen/widget_amount_size"
        android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="@dimen/widget_label_size" android:autoSizeMaxTextSize="@dimen/widget_amount_size" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
