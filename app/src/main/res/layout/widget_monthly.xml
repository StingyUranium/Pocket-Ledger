<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_month_preview" android:textColor="@color/widget_text" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_open" android:textColor="@color/widget_accent" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:id="@+id/widget_income_tile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:padding="9dp" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/widget_panel">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_income_label" android:textSize="12sp" android:textColor="@color/widget_secondary" />
            <TextView android:id="@+id/widget_income" android:layout_width="match_parent" android:layout_height="32dp" android:text="@string/widget_amount_preview" android:textSize="20sp" android:textColor="@color/widget_income" android:fontFamily="sans-serif-medium" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" android:gravity="center_vertical" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_spent_tile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:padding="9dp" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/widget_panel">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_spent_label" android:textSize="12sp" android:textColor="@color/widget_secondary" />
            <TextView android:id="@+id/widget_spent" android:layout_width="match_parent" android:layout_height="32dp" android:text="@string/widget_amount_preview" android:textSize="20sp" android:textColor="@color/widget_expense" android:fontFamily="sans-serif-medium" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" android:gravity="center_vertical" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_balance_tile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:padding="9dp" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/widget_panel">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_balance_label" android:textSize="12sp" android:textColor="@color/widget_secondary" />
            <TextView android:id="@+id/widget_balance" android:layout_width="match_parent" android:layout_height="32dp" android:text="@string/widget_amount_preview" android:textSize="20sp" android:textColor="@color/widget_text" android:fontFamily="sans-serif-medium" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" android:gravity="center_vertical" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
