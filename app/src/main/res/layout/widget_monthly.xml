<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_monthly_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:id="@+id/widget_income_tile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_income_tab" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:text="@string/widget_income_label" android:textSize="18sp" android:textColor="#999A9E" />
            <TextView android:id="@+id/widget_income_indicator" android:layout_width="match_parent" android:layout_height="2dp" android:background="#48494D" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_spent_tile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_expense_tab" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:text="@string/widget_expenses_label" android:textSize="18sp" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_expense_indicator" android:layout_width="match_parent" android:layout_height="2dp" android:background="#FF554D" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_total_tile" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <TextView android:layout_width="match_parent" android:layout_height="18dp" android:text="@string/widget_this_month" android:gravity="center" android:textSize="13sp" android:textColor="#EEEEEF" />
        <TextView android:id="@+id/widget_total" android:layout_width="match_parent" android:layout_height="28dp" android:text="@string/widget_amount_preview" android:gravity="center" android:textStyle="bold" android:fontFamily="sans-serif" android:textColor="#FFFFFF" android:textSize="24sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
</LinearLayout>
